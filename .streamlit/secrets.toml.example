# WZÓR sekretów aplikacji.
#
# Lokalnie: skopiuj ten plik do `.streamlit/secrets.toml` i uzupełnij wartości.
# Na produkcji (Streamlit Cloud): wklej tę zawartość w
#   Manage app → Settings → Secrets.
#
# UWAGA: prawdziwy `.streamlit/secrets.toml` jest w .gitignore i NIE trafia
# do repozytorium. Nie commituj kluczy ani hashy haseł.

# --- Ekstrakcja danych z PDF przez Claude (Anthropic) ---
ANTHROPIC_API_KEY = "sk-ant-..."
CLAUDE_MODEL = "claude-sonnet-4-6"

# --- Logowanie: konta użytkowników ---
[auth]
cookie_name = "instrukcje_bhp_auth"
# Losowy sekretny klucz do podpisu ciasteczka sesji. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_key = "WSTAW_LOSOWY_KLUCZ_64_ZNAKI"
cookie_expiry_days = 30

# Każdy użytkownik = osobna sekcja [auth.credentials.usernames.<login>].
# `password` to HASH bcrypt, NIE zwykłe hasło! Hash wygenerujesz poleceniem:
#   python tworz_uzytkownika.py
[auth.credentials.usernames.admin]
name = "Administrator"
email = "admin@example.com"
password = "$2b$12$WSTAW_TUTAJ_HASH_BCRYPT"

# Przykład kolejnego użytkownika (skopiuj i zmień login/hash):
# [auth.credentials.usernames.jkowalski]
# name = "Jan Kowalski"
# email = "jan.kowalski@example.com"
# password = "$2b$12$INNY_HASH_BCRYPT"
